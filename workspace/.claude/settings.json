{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [{"type": "command", "command": "python3 .claude/hooks/protect_config.py", "timeout": 10}]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command", "command": "python3 .claude/hooks/tests_must_pass.py", "timeout": 60}]
      }
    ]
  }
}
